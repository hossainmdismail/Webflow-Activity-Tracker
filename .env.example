# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# Your Webflow API personal access token or OAuth token.
# Required scopes: sites:read, pages:read
# Get yours at: https://webflow.com/dashboard → Account Settings → API Access
WEBFLOW_API_TOKEN=your_api_token_here

# The Webflow site ID you want to report on.
# Find it in your site settings URL:
#   https://webflow.com/design/<site-id>/...
# or via: GET https://api.webflow.com/v2/sites
WEBFLOW_SITE_ID=your_site_id_here
